{
  "appId": "jp.syukei.parent",
  "productName": "集計システム 親機",
  "icon": "build/icon.ico",
  "directories": {
    "output": "dist/parent"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    "server.js",
    "teamname.txt",
    "package.json",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "name": "syukei-parent",
    "main": "electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "server.js",
    "package.json",
    "public/**/*",
    "teamname.txt",
    "node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": false,
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "syukei-parent-setup-${version}.${ext}",
    "guid": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
  },
  "publish": {
    "provider": "github",
    "owner": "honi0907",
    "repo": "syukei"
  }
}
