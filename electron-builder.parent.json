{
  "appId": "jp.syukei.parent",
  "productName": "集計システム 親機",
  "directories": {
    "output": "dist/parent"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    "server.js",
    "teamname.txt",
    "package.json",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "asar": true,
  "asarUnpack": [
    "server.js",
    "package.json",
    "public/**/*",
    "teamname.txt",
    "node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "honi0907",
    "repo": "syukei"
  }
}
