{
  "name": "syukei-system",
  "version": "1.0.10",
  "description": "親機・子機スコア集計システム",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/honi0907/syukei.git"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "electron:child": "electron electron/koki/main.js",
    "dist:parent": "npm run icons && electron-builder --config electron-builder.parent.json",
    "dist:child": "npm run icons && electron-builder --config electron-builder.child.json",
    "dist:all": "npm run dist:parent && npm run dist:child",
    "icons": "node scripts/build-icons.js"
  },
  "keywords": [
    "scoring",
    "websocket",
    "realtime",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.0.1",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  }
}
